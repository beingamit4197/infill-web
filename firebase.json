{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|gif|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/privacy-policy.html",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/support.html",
        "destination": "/support",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/docs",
        "type": 301
      },
      {
        "source": "/openai-api-key.html",
        "destination": "/docs/openai-api-key",
        "type": 301
      },
      {
        "source": "/docs/openai-api-key.html",
        "destination": "/docs/openai-api-key",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
